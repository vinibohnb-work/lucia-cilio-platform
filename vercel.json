{
  "redirects": [
    {
      "source": "/momentos",
      "destination": "/momentos/",
      "permanent": true
    },
    {
      "source": "/momentos/participantes",
      "destination": "/momentos/participantes/",
      "permanent": true
    },
    {
      "source": "/v2",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/v2/:path*",
      "destination": "/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/consultoria-relatorio.js": {
      "maxDuration": 300
    }
  },
  "regions": [
    "fra1"
  ]
}
