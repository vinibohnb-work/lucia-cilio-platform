{
  "redirects": [
    {
      "source": "/momentos/:path*",
      "has": [
        {
          "type": "host",
          "value": "lucia-cilio-platform.vercel.app"
        }
      ],
      "destination": "https://lcoffice.pt/momentos/:path*",
      "permanent": false
    },
    {
      "source": "/momentos",
      "has": [
        {
          "type": "host",
          "value": "lucia-cilio-platform.vercel.app"
        }
      ],
      "destination": "https://lcoffice.pt/momentos/",
      "permanent": false
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "lucia-cilio-platform.vercel.app"
        }
      ],
      "destination": "https://app.lcoffice.pt/:path",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.lcoffice.pt"
        }
      ],
      "destination": "https://lcoffice.pt/:path*",
      "permanent": true
    },
    {
      "source": "/:path((?!momentos|api/|favicon\\.svg).*)",
      "has": [
        {
          "type": "host",
          "value": "lcoffice.pt"
        }
      ],
      "destination": "https://app.lcoffice.pt/:path",
      "permanent": false
    },
    {
      "source": "/momentos/:path*",
      "has": [
        {
          "type": "host",
          "value": "app.lcoffice.pt"
        }
      ],
      "destination": "https://lcoffice.pt/momentos/:path*",
      "permanent": false
    },
    {
      "source": "/momentos",
      "has": [
        {
          "type": "host",
          "value": "app.lcoffice.pt"
        }
      ],
      "destination": "https://lcoffice.pt/momentos/",
      "permanent": false
    },
    {
      "source": "/momentos",
      "destination": "/momentos/",
      "permanent": true
    },
    {
      "source": "/momentos/participantes",
      "destination": "/momentos/participantes/",
      "permanent": true
    },
    {
      "source": "/v2",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/v2/:path*",
      "destination": "/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/consultoria-relatorio.js": {
      "maxDuration": 300
    }
  },
  "regions": [
    "fra1"
  ]
}
