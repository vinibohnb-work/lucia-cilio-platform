# ── Cliente (frontend) — Supabase: Project Settings → API ──
VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Domínio de produção (usado no link de convite por email). Ex: https://lucia-cilio.vercel.app
# Se vazio, usa o domínio atual do browser.
VITE_APP_URL=

# ── Servidor (funções /api no Vercel) — gestão de utilizadores ──
# A SERVICE ROLE KEY é SECRETA: nunca usar prefixo VITE_ nem expor no frontend.
# Supabase → Project Settings → API → service_role (secret)
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...
